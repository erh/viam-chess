{
  "components": [
    {
      "name": "hack-pose-look-straight-down",
      "api": "rdk:component:switch",
      "model": "erh:vmodutils:arm-position-saver",
      "attributes": {
        "arm": "arm",
        "motion": "",
        "joints": [
          -0.076349139213562,
          -0.20220564305782318,
          -1.5693198442459106,
          -0.0012806119630113246,
          1.7407830953598022,
          3.0671448707580566
        ]
      },
      "ui_folder": {
        "name": "vision"
      }
    }
  ],
  "services": [
    {
      "name": "piece-finder",
      "api": "rdk:service:vision",
      "model": "erh:viam-chess:piece-finder",
      "attributes": {
        "input": "cam"
      },
      "ui_folder": {
        "name": "vision"
      }
    },
    {
      "name": "builtin",
      "api": "rdk:service:motion",
      "model": "rdk:builtin:builtin",
      "attributes": {
        "input_range_override": {
          "arm": {
            "3": {
              "max": 1.5,
              "min": -1.5
            },
            "5": {
              "max": 4.14,
              "min": 2.14
            }
          }
        }
      }
    },
    {
      "name": "chess",
      "api": "rdk:service:generic",
      "model": "erh:viam-chess:chess",
      "attributes": {
        "engine": "/usr/games/stockfish",
        "gripper": "gripper",
        "pose-start": "hack-pose-look-straight-down",
        "piece-finder": "piece-finder",
        "arm": "arm",
        "state-machine": "chess-modes"
      },
      "ui_folder": {
        "name": "app"
      }
    },
    {
      "name": "watch-board",
      "api": "rdk:service:task",
      "model": "erh:viam-chess:watch-board",
      "attributes": {
        "chess": "chess",
        "interval-ms": 1000
      },
      "ui_folder": {
        "name": "chess-tasks"
      }
    },
    {
      "name": "wait-human-move",
      "api": "rdk:service:task",
      "model": "erh:viam-chess:wait-human-move",
      "attributes": {
        "chess": "chess",
        "interval-ms": 1000
      },
      "ui_folder": {
        "name": "chess-tasks"
      }
    },
    {
      "name": "engine-move",
      "api": "rdk:service:task",
      "model": "erh:viam-chess:engine-move",
      "attributes": {
        "chess": "chess",
        "interval-ms": 1000
      },
      "ui_folder": {
        "name": "chess-tasks"
      }
    },
    {
      "name": "home",
      "api": "rdk:service:task",
      "model": "erh:viam-chess:home",
      "attributes": {
        "chess": "chess"
      },
      "ui_folder": {
        "name": "chess-tasks"
      }
    },
    {
      "name": "reset-board",
      "api": "rdk:service:task",
      "model": "erh:viam-chess:reset-board",
      "attributes": {
        "chess": "chess"
      },
      "ui_folder": {
        "name": "chess-tasks"
      }
    },
    {
      "name": "chess-modes",
      "api": "rdk:service:state_machine",
      "model": "rdk:builtin:builtin",
      "attributes": {
        "initial": "start",
        "cancel_timeout": "90s",
        "on": {
          "error": "error"
        },
        "states": {
          "start": {
            "initial": "wiping",
            "on": {
              "mode.vs_human": "vs_human",
              "mode.vs_self": "vs_self"
            },
            "states": {
              "wiping": {
                "task": {
                  "type": "do_command",
                  "resource": "chess",
                  "command": {
                    "wipe": true
                  }
                },
                "on": {
                  "done": "watching"
                }
              },
              "watching": {
                "task": {
                  "type": "resource",
                  "name": "watch-board"
                }
              }
            }
          },
          "vs_human": {
            "initial": "waiting",
            "on": {
              "pause": "idle",
              "mode.teaching": "teaching",
              "mode.start": "start"
            },
            "states": {
              "waiting": {
                "task": {
                  "type": "resource",
                  "name": "wait-human-move",
                  "input": {
                    "side": "black"
                  }
                },
                "on": {
                  "moved": "replying",
                  "engine_turn": "replying",
                  "game_over": "game_over"
                }
              },
              "replying": {
                "task": {
                  "type": "resource",
                  "name": "engine-move",
                  "input": {
                    "side": "black"
                  }
                },
                "on": {
                  "done": "waiting",
                  "game_over": "game_over"
                }
              }
            }
          },
          "vs_self": {
            "initial": "playing",
            "on": {
              "pause": "idle",
              "mode.start": "start"
            },
            "states": {
              "playing": {
                "task": {
                  "type": "resource",
                  "name": "engine-move"
                },
                "on": {
                  "done": "playing",
                  "game_over": "game_over"
                }
              }
            }
          },
          "teaching": {
            "task": {
              "type": "resource",
              "name": "watch-board"
            },
            "on": {
              "mode.vs_human": "vs_human",
              "pause": "idle",
              "mode.start": "start"
            }
          },
          "idle": {
            "task": {
              "type": "resource",
              "name": "watch-board"
            },
            "on": {
              "resume": "$history",
              "mode.vs_human": "vs_human",
              "mode.vs_self": "vs_self",
              "mode.teaching": "teaching",
              "mode.start": "start"
            }
          },
          "game_over": {
            "task": {
              "type": "resource",
              "name": "watch-board"
            },
            "on": {
              "mode.start": "start"
            }
          },
          "error": {
            "task": {
              "type": "resource",
              "name": "home"
            },
            "on": {
              "error": "stuck",
              "resume": "$history",
              "mode.vs_human": "vs_human",
              "mode.vs_self": "vs_self",
              "mode.start": "start"
            }
          },
          "stuck": {
            "on": {
              "mode.start": "start"
            }
          }
        }
      },
      "ui_folder": {
        "name": "app"
      }
    },
    {
      "name": "buttons",
      "api": "rdk:service:generic",
      "model": "erh:viam-streamdeck:streamdeck-any",
      "attributes": {
        "dials": [
          {
            "dial": 0,
            "component": "chess",
            "command": "skill"
          }
        ],
        "brightness": 100,
        "keys": [
          {
            "color": "green",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "go": 1
              }
            ],
            "text": "move 1",
            "key": 0
          },
          {
            "method": "do_command",
            "args": [
              {
                "go": 2
              }
            ],
            "text": "move 2",
            "key": 1,
            "color": "green",
            "component": "chess"
          },
          {
            "color": "green",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "go": 10
              }
            ],
            "text": "move 10",
            "key": 2
          },
          {
            "color": "green",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "go": 40
              }
            ],
            "text": "move 40",
            "key": 3
          },
          {
            "color": "orange",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "reset": true
              }
            ],
            "text": "reset",
            "key": 4
          },
          {
            "key": 5,
            "color": "red",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "wipe": true
              }
            ],
            "text": "wipe"
          },
          {
            "key": 6,
            "color": "blue",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "mode": 2
              }
            ],
            "text": "vs human"
          },
          {
            "key": 7,
            "color": "blue",
            "component": "chess",
            "method": "do_command",
            "args": [
              {
                "mode": 1
              }
            ],
            "text": "pause"
          }
        ]
      },
      "ui_folder": {
        "name": "app"
      }
    },
    {
      "name": "shell",
      "api": "rdk:service:shell",
      "attributes": {}
    }
  ],
  "modules": [
    {
      "type": "registry",
      "name": "erh_vmodutils",
      "module_id": "erh:vmodutils",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "erh_viam-chess",
      "module_id": "erh:viam-chess",
      "version": "latest"
    },
    {
      "type": "registry",
      "name": "erh_viam-streamdeck",
      "module_id": "erh:viam-streamdeck",
      "version": "latest",
      "reload_path": "~/.viam/packages-local/erh_viam-streamdeck_from_reload-module.tar.gz",
      "reload_enabled": true
    }
  ],
  "fragments": [
    {
      "id": "f6e98d80-20a0-4fb6-9cb3-7b527a91ec10",
      "variables": {
        "arm-name": "arm",
        "arm-ip-address": "10.1.1.50",
        "cam-serial-number": "327122073698"
      }
    }
  ],
  "fragment_mods": [
